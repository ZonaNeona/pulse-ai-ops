# Copy to .env and fill in. Never commit .env.

# --- Data source -------------------------------------------------------------
# emulator: built-in Bitrix24-compatible emulator with the demo company (default)
# live:     your own Bitrix24 portal via an inbound webhook (read-only)
CRM_MODE=emulator
B24_WEBHOOK_URL=

# emulator: built-in 1С with the demo company's accounting (default)
# live:     your 1С through the standard OData interface (read-only)
ERP_MODE=emulator
ONEC_ODATA_URL=
ONEC_USER=
ONEC_PASSWORD=

# Delta sync interval; in emulator mode the demo company is regenerated when the day changes.
SYNC_INTERVAL_S=180
# Protects POST /api/admin/reset. Empty disables the endpoint.
ADMIN_KEY=

# --- AI ---------------------------------------------------------------------
# Any OpenAI-compatible endpoint; OpenRouter by default.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-chat
LLM_VISION_MODEL=google/gemini-2.5-flash-lite

# Hard daily cap for all AI calls, USD. Above the cap the stand answers without a model.
AI_DAILY_USD=1.5
AI_VISITOR_QUESTIONS=10
AI_VISITOR_DOCUMENTS=3

# --- Hermes Agent (optional) ------------------------------------------------
# If empty, the built-in tool loop answers instead.
HERMES_API_URL=
HERMES_API_KEY=

# --- Telegram (optional) ----------------------------------------------------
TELEGRAM_BOT_TOKEN=
PUBLIC_URL=http://127.0.0.1:8010

# --- Storage ----------------------------------------------------------------
# Where SQLite and the generated demo data live (default: <repo>/var)
# PULSE_DATA_DIR=/srv/pulse/var
