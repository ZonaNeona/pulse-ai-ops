[Unit]
Description=Pulse AI Ops — Nightly seed reset
After=pulse-api.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/pulse/pulse.env
# Through the running API, so the reset takes the same lock as its background sync loop.
ExecStart=/bin/sh -c 'curl -fsS -X POST -H "X-Admin-Key: $ADMIN_KEY" http://127.0.0.1:8010/api/admin/reset'
