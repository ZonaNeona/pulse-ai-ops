[Unit]
Description=Pulse AI Ops — Hermes Agent, profile pulse (API server only)
After=network-online.target pulse-api.service
Wants=network-online.target

[Service]
Type=simple
User=hermes
Group=hermes
Environment=HOME=/home/hermes
Environment=HERMES_HOME=/home/hermes/.hermes
Environment=HERMES_API_TIMEOUT=60
ExecStart=/home/hermes/.local/bin/hermes -p pulse gateway run
Restart=always
RestartSec=5
MemoryHigh=450M
MemoryMax=600M

[Install]
WantedBy=multi-user.target
